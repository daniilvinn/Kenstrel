+#[cfg(test)]
+mod tests {
+    use crossterm::event::{KeyEventKind, KeyEventState};
+    use ks_claude::pane::Cell;
+    use ks_claude::preflight::AuthStatus;
+
+    use super::*;
+
+    fn key(code: KeyCode, modifiers: KeyModifiers) -> KeyEvent {
+        KeyEvent {
+            code,
+            modifiers,
+            kind: KeyEventKind::Press,
+            state: KeyEventState::NONE,
+        }
+    }
+
+    #[test]
+    fn keys_convert_with_modifiers() {
+        let k = to_pane_key(key(KeyCode::Char('c'), KeyModifiers::CONTROL)).unwrap();
+        assert_eq!(k, PaneKeyEvent::with(PaneKey::Char('c'), PaneMods::CTRL));
+        let k = to_pane_key(key(KeyCode::Char('A'), KeyModifiers::SHIFT)).unwrap();
+        assert_eq!(k, PaneKeyEvent::new(PaneKey::Char('A')));
+        let k = to_pane_key(key(KeyCode::BackTab, KeyModifiers::SHIFT)).unwrap();
+        assert_eq!(k.code, PaneKey::BackTab);
+        let k = to_pane_key(key(KeyCode::Left, KeyModifiers::ALT)).unwrap();
+        assert_eq!(k, PaneKeyEvent::with(PaneKey::Left, PaneMods::ALT));
+        let alt_gr = to_pane_key(key(
+            KeyCode::Char('?'),
+            KeyModifiers::CONTROL | KeyModifiers::ALT,
+        ))
+        .unwrap();
+        assert_eq!(alt_gr, PaneKeyEvent::new(PaneKey::Char('?')));
+        assert!(to_pane_key(key(KeyCode::CapsLock, KeyModifiers::NONE)).is_none());
+        assert_eq!(
+            to_pane_key(key(KeyCode::F(5), KeyModifiers::NONE))
+                .unwrap()
+                .code,
+            PaneKey::F(5)
+        );
+    }
+
+    #[test]
+    fn preflight_results_map_to_core() {
+        let status = |method: &str| AuthStatus {
+            logged_in: true,
+            auth_method: Some(method.to_owned()),
+            api_provider: Some("firstParty".to_owned()),
+            subscription_type: None,
+        };
+        assert_eq!(
+            convert_preflight(PreflightResult::Ok(status("claude.ai"))),
+            ClaudePreflight::Ok
+        );
+        match convert_preflight(PreflightResult::BillingWarning(status("api_key"))) {
+            ClaudePreflight::BillingWarning(text) => {
+                assert!(text.contains("api_key") && text.contains("billed"));
+            }
+            other => panic!("{other:?}"),
+        }
+        assert!(matches!(
+            convert_preflight(PreflightResult::NotLoggedIn),
+            ClaudePreflight::NotLoggedIn(t) if t.contains("/login")
+        ));
+        assert!(matches!(
+            convert_preflight(PreflightResult::NotInstalled {
+                instructions: "x".into()
+            }),
+            ClaudePreflight::NotInstalled(t) if t == "x"
+        ));
+        assert!(matches!(
+            convert_preflight(PreflightResult::Failed("f".into())),
+            ClaudePreflight::Failed(t) if t == "f"
+        ));
+    }
+
+    #[test]
+    fn snapshots_convert_cell_by_cell() {
+        let snapshot = ScreenSnapshot {
+            rows: 1,
+            cols: 2,
+            cells: vec![
+                Cell {
+                    text: "?".into(),
+                    fg: Color::Rgb(1, 2, 3),
+                    bold: true,
+                    ..Cell::default()
+                },
+                Cell {
+                    text: "x".into(),
+                    wide_continuation: true,
+                    bg: Color::Indexed(4),
+                    inverse: true,
+                    ..Cell::default()
+                },
+            ],
+            cursor: Some((0, 1)),
+            alternate_screen: true,
+            bracketed_paste: false,
+        };
+        let screen = convert_screen(&snapshot);
+        assert_eq!(
+            (screen.rows, screen.cols, screen.cursor),
+            (1, 2, Some((0, 1)))
+        );
+        assert_eq!(screen.cells[0].text, "?");
+        assert_eq!(screen.cells[0].fg, ClaudeColor::Rgb(1, 2, 3));
+        assert!(screen.cells[0].bold);
+        assert_eq!(screen.cells[1].text, "");
+        assert_eq!(screen.cells[1].bg, ClaudeColor::Indexed(4));
+        assert!(screen.cells[1].inverse);
+    }
+
+    #[tokio::test(flavor = "multi_thread")]
+    async fn ipc_requests_are_answered_from_state_and_apply_messages() {
+        use ks_claude::ipc::{call, Request, Response};
+        use ks_core::{Config, Keymap, StartParams};
+
+        let dir = tempfile::tempdir().unwrap();
+        std::fs::write(
+            dir.path().join("a.txt"),
+            "needle
+",
+        )
+        .unwrap();
+        let state = AppState::new(StartParams {
+            cwd: dir.path().to_path_buf(),
+            home: None,
+            config: Config::default(),
+            keymap: Keymap::defaults(),
+            size: Size::new(80, 24),
+        });
+        let (msgs_tx, _msgs_rx) = mpsc::channel(8);
+        let (mut host, mut events) = ClaudeHost::new(ClaudeOptions::default(), msgs_tx);
+        let name = host.ensure_ipc().expect("ipc server starts");
+
+        let requests = vec![
+            Request::GetSelection,
+            Request::Reveal {
+                path: "a.txt".into(),
+            },
+            Request::SearchContents {
+                pattern: "needle".into(),
+                glob: None,
+                regex: false,
+                limit: 10,
+            },
+        ];
+        let client = tokio::spawn(async move {
+            let mut out = Vec::new();
+            for request in requests {
+                out.push(
+                    call(&name, &request, std::time::Duration::from_secs(10))
+                        .await
+                        .unwrap(),
+                );
+            }
+            out
+        });
+
+        let mut applied = Vec::new();
+        for _ in 0..3 {
+            let event = events.recv().await.expect("an ipc event");
+            applied.extend(host.on_event(event, &state));
+        }
+        let responses = client.await.unwrap();
+        assert!(matches!(responses[0], Response::Selection { .. }));
+        assert_eq!(responses[1], Response::Ok);
+        match &responses[2] {
+            Response::Matches { hits, .. } => assert_eq!(hits.len(), 1),
+            other => panic!("{other:?}"),
+        }
+        assert_eq!(
+            applied,
+            vec![Msg::ClaudeReveal {
+                path: dir.path().join("a.txt")
+            }]
+        );
+        host.shutdown();
+    }
+
+    /// Needs the real `claude`: launches it in a temp dir (no input is ever sent), renders the
+    /// first screen through the app wiring and shuts it down. Run with `--ignored`.
+    #[tokio::test(flavor = "multi_thread")]
+    #[ignore = "launches the real claude CLI"]
+    async fn real_claude_renders_through_the_app_wiring() {
+        use ks_core::{update, Config, Keymap, StartParams};
+        use ks_ui::{ColorDepth, Theme};
+        use ratatui::backend::TestBackend;
+        use ratatui::Terminal;
+
+        let dir = tempfile::tempdir().unwrap();
+        let mut state = AppState::new(StartParams {
+            cwd: dir.path().to_path_buf(),
+            home: None,
+            config: Config::default(),
+            keymap: Keymap::defaults(),
+            size: Size::new(140, 40),
+        });
+        let (msgs_tx, _msgs_rx) = mpsc::channel(8);
+        let options = ClaudeOptions {
+            sessions_file: Some(dir.path().join("sessions.json")),
+            launch_dir: Some(dir.path().join("launch")),
+        };
+        let (mut host, mut events) = ClaudeHost::new(options, msgs_tx);
+
+        let mut pending = update(&mut state, Msg::Key("c".parse().unwrap()));
+        let generation = state.claude.generation;
+        pending.clear();
+        update(
+            &mut state,
+            Msg::ClaudePreflight {
+                generation,
+                result: ClaudePreflight::Ok,
+            },
+        )
+        .into_iter()
+        .for_each(|e| {
+            for m in host.run_effect(e, &state) {
+                update(&mut state, m);
+            }
+        });
+        assert!(
+            state.claude.is_running(),
+            "launch failed: {:?}",
+            state.status
+        );
+
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(20);
+        let mut text = String::new();
+        while std::time::Instant::now() < deadline && !text.to_lowercase().contains("trust") {
+            if let Ok(Some(event)) =
+                tokio::time::timeout(std::time::Duration::from_millis(500), events.recv()).await
+            {
+                for msg in host.on_event(event, &state) {
+                    update(&mut state, msg);
+                }
+            }
+            let theme = Theme::builtin("ember", ColorDepth::TrueColor).unwrap();
+            let mut terminal = Terminal::new(TestBackend::new(140, 40)).unwrap();
+            terminal.draw(|f| ks_ui::render(f, &state, &theme)).unwrap();
+            let buf = terminal.backend().buffer();
+            text = (2..36)
+                .map(|y| (60..140).map(|x| buf[(x, y)].symbol()).collect::<String>())
+                .collect::<Vec<_>>()
+                .join("|");
+            text = text.replace(['?', ' ', '|'], "");
+        }
+        assert!(
+            text.to_lowercase().contains("trust"),
+            "unexpected pane content: {text}"
+        );
+        host.shutdown();
+    }
+
+    #[test]
+    fn sessions_file_lives_in_the_state_dir() {
+        assert_eq!(
+            sessions_file(Path::new("/s")),
+            PathBuf::from("/s/claude-sessions.json")
+        );
+    }
+}
