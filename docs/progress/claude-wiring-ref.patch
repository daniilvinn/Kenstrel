+//! Glue between the `ks-claude` engine and the app: runs the Claude effects, owns the pane and
+//! the IPC server, and turns engine events into core messages.
+//!
+//! Engine threads report through an unbounded channel (the sink never blocks, which matters
+//! because the IPC server calls it from inside its own async runtime); the event loop drains it
+//! and calls [`ClaudeHost::on_event`] with access to the current state.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use crossterm::event::{KeyCode, KeyEvent, KeyModifiers};
+use ks_claude::events::{ClaudeEvent, EventSink};
+use ks_claude::gen::{default_launch_dir, write_launch_files, HookCommandStyle};
+use ks_claude::ipc::{ipc_name_for_pid, IpcServer, IpcServerOptions, IPC_ENV};
+use ks_claude::keys::{KeyCode as PaneKey, KeyEvent as PaneKeyEvent, Modifiers as PaneMods};
+use ks_claude::pane::{ClaudePane, Color, PaneConfig, PaneError, PaneSize, ScreenSnapshot};
+use ks_claude::preflight::{PreflightOptions, PreflightResult};
+use ks_claude::session::{new_session_id, SessionMode, SessionStore};
+use ks_claude::wt::{launch_wt_split, WtSplit};
+use ks_core::claude::{pane_area, ClaudeCell, ClaudeColor, ClaudePreflight, ClaudeScreen};
+use ks_core::{AppState, Effect, Level, Msg, Overlay, Size};
+use tokio::sync::mpsc::{self, UnboundedReceiver, UnboundedSender};
+use tokio_util::sync::CancellationToken;
+
+use crate::ipc_handler::{self, Outcome};
+
+/// Where the host keeps its files. All optional so tests never touch the real locations.
+#[derive(Clone, Debug, Default)]
+pub struct ClaudeOptions {
+    /// JSON map of project root to session id (`SessionStore`). `None` disables resume.
+    pub sessions_file: Option<PathBuf>,
+    /// Directory for the generated `--mcp-config` / `--settings` files
+    /// (default: `<temp>/kestrel-<pid>`).
+    pub launch_dir: Option<PathBuf>,
+}
+
+struct Running {
+    pane: ClaudePane,
+    generation: u64,
+    cwd: PathBuf,
+    size: PaneSize,
+}
+
+/// Owns everything Claude-related that is not plain state.
+pub struct ClaudeHost {
+    options: ClaudeOptions,
+    sink: EventSink,
+    msgs: mpsc::Sender<Msg>,
+    shutdown: CancellationToken,
+    running: Option<Running>,
+    ipc: Option<IpcServer>,
+    launch_dir: Option<PathBuf>,
+}
+
+impl ClaudeHost {
+    /// Creates the host and the channel the event loop must drain. `msgs` receives results of
+    /// effects that complete off-loop (for example the Windows Terminal launch).
+    pub fn new(
+        options: ClaudeOptions,
+        msgs: mpsc::Sender<Msg>,
+    ) -> (Self, UnboundedReceiver<ClaudeEvent>) {
+        let (tx, rx): (UnboundedSender<ClaudeEvent>, _) = mpsc::unbounded_channel();
+        let sink: EventSink = Arc::new(move |event| {
+            // The receiver is gone only during shutdown.
+            let _ = tx.send(event);
+        });
+        let host = Self {
+            options,
+            sink,
+            msgs,
+            shutdown: CancellationToken::new(),
+            running: None,
+            ipc: None,
+            launch_dir: None,
+        };
+        (host, rx)
+    }
+
+    /// True while an embedded pane exists.
+    pub fn has_pane(&self) -> bool {
+        self.running.is_some()
+    }
+
+    /// Runs one Claude effect, returning messages to apply right away.
+    pub fn run_effect(&mut self, effect: Effect, state: &AppState) -> Vec<Msg> {
+        match effect {
+            Effect::ClaudePreflight { generation } => {
+                ks_claude::preflight::spawn_preflight(
+                    generation,
+                    PreflightOptions::default(),
+                    self.shutdown.child_token(),
+                    self.sink.clone(),
+                );
+                Vec::new()
+            }
+            Effect::ClaudeLaunch {
+                generation,
+                cwd,
+                resume,
+                size,
+            } => match self.launch(generation, cwd, resume, size, state) {
+                Ok(()) => vec![Msg::ClaudeStarted { generation }],
+                Err(e) => vec![Msg::ClaudeLaunchFailed {
+                    generation,
+                    message: e.to_string(),
+                }],
+            },
+            Effect::ClaudeSendPaths { paths } => {
+                if let Some(running) = &self.running {
+                    let text = ks_claude::mention::format_mentions(&paths, &running.cwd);
+                    if let Err(e) = running.pane.paste(&text) {
+                        tracing::warn!("cannot paste mentions into Claude: {e}");
+                    }
+                }
+                Vec::new()
+            }
+            Effect::ClaudeWtSplit { cwd } => {
+                let msgs = self.msgs.clone();
+                // `wt` is spawned detached; do it off the loop in case the launch is slow.
+                tokio::task::spawn_blocking(move || {
+                    let msg = match launch_wt_split(&WtSplit::new(cwd)) {
+                        Ok(()) => Msg::Notify {
+                            level: Level::Info,
+                            text: "Opened Claude in a Windows Terminal split".to_owned(),
+                        },
+                        Err(e) => Msg::Notify {
+                            level: Level::Error,
+                            text: format!("Could not open a Windows Terminal split: {e}"),
+                        },
+                    };
+                    let _ = msgs.blocking_send(msg);
+                });
+                Vec::new()
+            }
+            // Timers belong to the generic effect runner.
+            Effect::StartTimer { .. } | Effect::CancelTimer(_) => Vec::new(),
+        }
+    }
+
+    fn launch(
+        &mut self,
+        generation: u64,
+        cwd: PathBuf,
+        resume: bool,
+        size: Size,
+        _state: &AppState,
+    ) -> Result<(), LaunchError> {
+        self.running = None; // drops (and kills) a previous pane
+        let ipc_name = self.ensure_ipc();
+
+        let mode = match &self.options.sessions_file {
+            Some(file) => SessionStore::new(file).mode_for(&cwd, resume)?,
+            None => SessionMode::New(new_session_id()),
+        };
+        let mut args = mode.args();
+        let mut env = Vec::new();
+        if let Some(name) = &ipc_name {
+            match self.write_launch_files(name) {
+                Ok(files) => {
+                    args.extend(files.claude_args());
+                    env.push((IPC_ENV.to_owned(), name.clone()));
+                }
+                Err(e) => tracing::warn!("cannot write Claude launch files: {e}"),
+            }
+        }
+
+        let pane_size = PaneSize {
+            cols: size.width.max(1),
+            rows: size.height.max(1),
+        };
+        let mut config = PaneConfig::new(cwd.clone(), pane_size);
+        config.args = args;
+        config.env = env;
+        let pane = ClaudePane::spawn(
+            config,
+            generation,
+            self.sink.clone(),
+            self.shutdown.child_token(),
+        )?;
+        self.running = Some(Running {
+            pane,
+            generation,
+            cwd,
+            size: pane_size,
+        });
+        Ok(())
+    }
+
+    /// Starts the IPC server on first use; `None` if it cannot start (Claude then runs without
+    /// the Kestrel MCP tools and hooks).
+    fn ensure_ipc(&mut self) -> Option<String> {
+        if let Some(server) = &self.ipc {
+            return Some(server.name().to_owned());
+        }
+        let name = ipc_name_for_pid(std::process::id());
+        match IpcServer::start(
+            &name,
+            0,
+            self.sink.clone(),
+            self.shutdown.child_token(),
+            IpcServerOptions::default(),
+        ) {
+            Ok(server) => {
+                self.ipc = Some(server);
+                Some(name)
+            }
+            Err(e) => {
+                tracing::warn!("cannot start the IPC server: {e}");
+                None
+            }
+        }
+    }
+
+    fn write_launch_files(
+        &mut self,
+        ipc_name: &str,
+    ) -> std::io::Result<ks_claude::gen::LaunchFiles> {
+        let ks_exe = std::env::current_exe()?;
+        let dir = self
+            .options
+            .launch_dir
+            .clone()
+            .unwrap_or_else(default_launch_dir);
+        let files = write_launch_files(&dir, &ks_exe, ipc_name, HookCommandStyle::default())?;
+        self.launch_dir = Some(dir);
+        Ok(files)
+    }
+
+    /// Converts an engine event into messages, answering IPC requests from `state`.
+    pub fn on_event(&mut self, event: ClaudeEvent, state: &AppState) -> Vec<Msg> {
+        match event {
+            ClaudeEvent::Preflight { generation, result } => vec![Msg::ClaudePreflight {
+                generation,
+                result: convert_preflight(result),
+            }],
+            ClaudeEvent::PaneUpdated { generation } => match &self.running {
+                Some(r) if r.generation == generation => vec![Msg::ClaudeScreen {
+                    generation,
+                    screen: Box::new(convert_screen(&r.pane.snapshot())),
+                }],
+                _ => Vec::new(),
+            },
+            ClaudeEvent::PaneExited { generation, code } => {
+                if self
+                    .running
+                    .as_ref()
+                    .is_some_and(|r| r.generation == generation)
+                {
+                    self.running = None;
+                }
+                vec![Msg::ClaudePaneExited { generation, code }]
+            }
+            ClaudeEvent::Ipc { request, reply, .. } => match ipc_handler::answer(request, state) {
+                Outcome::Now(response, msgs) => {
+                    reply.send(response);
+                    msgs
+                }
+                Outcome::Blocking(work) => {
+                    tokio::task::spawn_blocking(move || reply.send(work()));
+                    Vec::new()
+                }
+            },
+        }
+    }
+
+    /// Resizes the pane to match the layout of `state`.
+    pub fn sync_size(&mut self, state: &AppState) {
+        let Some(running) = &mut self.running else {
+            return;
+        };
+        let Some(area) = pane_area(state.size) else {
+            return;
+        };
+        let inner = area.inner_size();
+        let size = PaneSize {
+            cols: inner.width.max(1),
+            rows: inner.height.max(1),
+        };
+        if size != running.size {
+            running.pane.resize(size);
+            running.size = size;
+        }
+    }
+
+    /// True when keys should be forwarded to the pane instead of going through the keymap.
+    pub fn wants_keys(&self, state: &AppState) -> bool {
+        self.running.is_some() && state.overlays.last() == Some(&Overlay::Claude)
+    }
+
+    /// Forwards a key verbatim to the pane.
+    pub fn forward_key(&self, key: KeyEvent) {
+        let (Some(running), Some(key)) = (&self.running, to_pane_key(key)) else {
+            return;
+        };
+        if let Err(e) = running.pane.send_key(key) {
+            tracing::debug!("cannot send a key to Claude: {e}");
+        }
+    }
+
+    /// Scrolls the pane history by `lines` (positive = older) and returns the redraw message.
+    pub fn scroll(&self, lines: isize) -> Option<Msg> {
+        let running = self.running.as_ref()?;
+        running.pane.scroll_by(lines);
+        Some(Msg::ClaudeScreen {
+            generation: running.generation,
+            screen: Box::new(convert_screen(&running.pane.snapshot())),
+        })
+    }
+
+    /// Forwards pasted text (bracketed only if Claude asked for it).
+    pub fn forward_paste(&self, text: &str) {
+        if let Some(running) = &self.running {
+            if let Err(e) = running.pane.paste(text) {
+                tracing::debug!("cannot paste into Claude: {e}");
+            }
+        }
+    }
+
+    /// Stops everything: kills the pane, closes the IPC server and removes generated files.
+    pub fn shutdown(&mut self) {
+        self.shutdown.cancel();
+        self.running = None;
+        self.ipc = None;
+        if let Some(dir) = self.launch_dir.take() {
+            let _ = std::fs::remove_dir_all(dir);
+        }
+    }
+}
+
+impl Drop for ClaudeHost {
+    fn drop(&mut self) {
+        self.shutdown();
+    }
+}
+
+#[derive(Debug, thiserror::Error)]
+enum LaunchError {
+    #[error(transparent)]
+    Pane(#[from] PaneError),
+    #[error("cannot store the session id: {0}")]
+    Session(#[from] std::io::Error),
+}
+
+/// Maps the engine's preflight outcome to the core type, adding the user-facing text.
+pub fn convert_preflight(result: PreflightResult) -> ClaudePreflight {
+    match result {
+        PreflightResult::Ok(_) => ClaudePreflight::Ok,
+        PreflightResult::BillingWarning(status) => {
+            let method = status.auth_method.as_deref().unwrap_or("an API key");
+            let provider = status.api_provider.as_deref().unwrap_or("unknown");
+            ClaudePreflight::BillingWarning(format!(
+                "Claude is logged in with {method} (provider: {provider}), not your Pro/Max \
+                 subscription.\nUsage would be billed to that key or provider instead of your plan."
+            ))
+        }
+        PreflightResult::NotLoggedIn => ClaudePreflight::NotLoggedIn(
+            "Run `claude` in a terminal once and use /login with your Pro/Max account,\nthen try again."
+                .to_owned(),
+        ),
+        PreflightResult::NotInstalled { instructions } => ClaudePreflight::NotInstalled(instructions),
+        PreflightResult::Failed(message) => ClaudePreflight::Failed(message),
+    }
+}
+
+fn convert_color(color: Color) -> ClaudeColor {
+    match color {
+        Color::Default => ClaudeColor::Default,
+        Color::Indexed(i) => ClaudeColor::Indexed(i),
+        Color::Rgb(r, g, b) => ClaudeColor::Rgb(r, g, b),
+    }
+}
+
+/// Converts the engine snapshot to the core screen type.
+pub fn convert_screen(snapshot: &ScreenSnapshot) -> ClaudeScreen {
+    ClaudeScreen {
+        cols: snapshot.cols,
+        rows: snapshot.rows,
+        cells: snapshot
+            .cells
+            .iter()
+            .map(|c| ClaudeCell {
+                text: if c.wide_continuation {
+                    String::new()
+                } else {
+                    c.text.clone()
+                },
+                fg: convert_color(c.fg),
+                bg: convert_color(c.bg),
+                bold: c.bold,
+                dim: c.dim,
+                italic: c.italic,
+                underline: c.underline,
+                inverse: c.inverse,
+            })
+            .collect(),
+        cursor: snapshot.cursor,
+    }
+}
+
+/// Converts a crossterm key to the engine's key type; `None` for keys a terminal cannot send.
+pub fn to_pane_key(event: KeyEvent) -> Option<PaneKeyEvent> {
+    let code = match event.code {
+        KeyCode::Char(c) => PaneKey::Char(c),
+        KeyCode::Enter => PaneKey::Enter,
+        KeyCode::Tab => PaneKey::Tab,
+        KeyCode::BackTab => PaneKey::BackTab,
+        KeyCode::Backspace => PaneKey::Backspace,
+        KeyCode::Esc => PaneKey::Esc,
+        KeyCode::Up => PaneKey::Up,
+        KeyCode::Down => PaneKey::Down,
+        KeyCode::Left => PaneKey::Left,
+        KeyCode::Right => PaneKey::Right,
+        KeyCode::Home => PaneKey::Home,
+        KeyCode::End => PaneKey::End,
+        KeyCode::PageUp => PaneKey::PageUp,
+        KeyCode::PageDown => PaneKey::PageDown,
+        KeyCode::Delete => PaneKey::Delete,
+        KeyCode::Insert => PaneKey::Insert,
+        KeyCode::F(n) => PaneKey::F(n),
+        _ => return None,
+    };
+    let has = |flag| event.modifiers.contains(flag);
+    // Windows reports AltGr as Ctrl+Alt; a character typed that way is just a character.
+    let alt_gr =
+        has(KeyModifiers::CONTROL) && has(KeyModifiers::ALT) && matches!(code, PaneKey::Char(_));
+    let is_char = matches!(code, PaneKey::Char(_));
+    let mods = PaneMods {
+        // The character already carries its case.
+        shift: has(KeyModifiers::SHIFT) && !is_char,
+        alt: has(KeyModifiers::ALT) && !alt_gr,
+        ctrl: has(KeyModifiers::CONTROL) && !alt_gr,
+    };
+    Some(PaneKeyEvent::with(code, mods))
+}
+
+/// Path of the sessions file under the state directory.
+pub fn sessions_file(state_dir: &Path) -> PathBuf {
+    state_dir.join("claude-sessions.json")
+}
