@@ -0,0 +1,214 @@
+//! Claude Code integration state (PLAN section 10), as plain data.
+//!
+//! The engine (`ks-claude`) lives outside this crate; the app converts its events into the
+//! [`Msg`](crate::msg::Msg) variants that carry the types defined here.
+
+use std::collections::BTreeSet;
+use std::path::PathBuf;
+
+use crate::state::Size;
+
+/// Share of the terminal width given to the Claude pane, in percent.
+pub const PANE_WIDTH_PERCENT: u16 = 45;
+/// Narrowest useful pane; below this the pane is not shown side by side.
+pub const PANE_MIN_COLS: u16 = 40;
+/// Rows used by the main screen outside the body: header, two rules and the prompt line.
+const CHROME_ROWS: u16 = 4;
+/// Terminals at least this tall also show the hint line (mirrors `ks_ui::HINT_MIN_HEIGHT`).
+const HINT_MIN_HEIGHT: u16 = 20;
+
+/// Outer rectangle of the Claude pane, in terminal cells.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PaneArea {
+    pub x: u16,
+    pub y: u16,
+    pub width: u16,
+    pub height: u16,
+}
+
+impl PaneArea {
+    /// Cells available to the embedded terminal: the pane minus its left border.
+    pub const fn inner_size(self) -> Size {
+        Size::new(self.width.saturating_sub(1), self.height)
+    }
+}
+
+/// Where the pane is drawn for a terminal of `size`, or `None` when it does not fit.
+pub fn pane_area(size: Size) -> Option<PaneArea> {
+    let hint = u16::from(size.height >= HINT_MIN_HEIGHT);
+    let height = size
+        .height
+        .checked_sub(CHROME_ROWS + hint)
+        .filter(|h| *h > 0)?;
+    let mut width =
+        size.width / 100 * PANE_WIDTH_PERCENT + size.width % 100 * PANE_WIDTH_PERCENT / 100;
+    width = width.max(PANE_MIN_COLS);
+    if size.width < PANE_MIN_COLS * 2 {
+        // Too narrow for a side-by-side layout: the pane covers the whole body.
+        width = size.width;
+    }
+    if width < 3 {
+        return None;
+    }
+    Some(PaneArea {
+        x: size.width - width,
+        y: 2,
+        width,
+        height,
+    })
+}
+
+/// Result of the `claude auth status` preflight (mirrors `ks_claude::preflight::PreflightResult`).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ClaudePreflight {
+    /// Subscription login: safe to launch.
+    Ok,
+    /// Logged in but Claude would bill an API key / provider; needs explicit confirmation.
+    BillingWarning(String),
+    /// Not logged in; the text tells the user what to do.
+    NotLoggedIn(String),
+    /// `claude` is not installed; the text holds the install instructions.
+    NotInstalled(String),
+    /// The check itself failed.
+    Failed(String),
+}
+
+/// A terminal colour of an embedded-terminal cell.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum ClaudeColor {
+    #[default]
+    Default,
+    Indexed(u8),
+    Rgb(u8, u8, u8),
+}
+
+/// One cell of the embedded terminal.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ClaudeCell {
+    /// Grapheme; empty for blanks and for the right half of a wide character.
+    pub text: String,
+    pub fg: ClaudeColor,
+    pub bg: ClaudeColor,
+    pub bold: bool,
+    pub dim: bool,
+    pub italic: bool,
+    pub underline: bool,
+    pub inverse: bool,
+}
+
+/// A snapshot of the embedded terminal, row-major.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ClaudeScreen {
+    pub cols: u16,
+    pub rows: u16,
+    pub cells: Vec<ClaudeCell>,
+    /// Cursor `(row, col)`, `None` when hidden.
+    pub cursor: Option<(u16, u16)>,
+}
+
+impl ClaudeScreen {
+    pub fn cell(&self, row: u16, col: u16) -> Option<&ClaudeCell> {
+        if row >= self.rows || col >= self.cols {
+            return None;
+        }
+        self.cells
+            .get(usize::from(row) * usize::from(self.cols) + usize::from(col))
+    }
+}
+
+/// Lifecycle of the embedded pane.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum ClaudePhase {
+    #[default]
+    Idle,
+    /// `claude auth status` is running.
+    Checking,
+    /// Preflight passed (or was confirmed); the process is being started.
+    Starting,
+    Running,
+}
+
+/// A modal message about the Claude integration (shown with `Overlay::Confirm`).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ClaudeDialog {
+    /// API billing warning; accepting launches anyway.
+    Billing(String),
+    /// Information only (install instructions, not logged in, failures).
+    Info { title: String, body: String },
+}
+
+/// Everything the app remembers about Claude.
+#[derive(Clone, Debug, Default)]
+pub struct ClaudeState {
+    pub phase: ClaudePhase,
+    /// Generation of the current preflight / pane; results carrying another one are stale.
+    pub generation: u64,
+    /// The next launch resumes the last session of the project.
+    pub resume: bool,
+    pub dialog: Option<ClaudeDialog>,
+    /// Latest screen of the pane while running.
+    pub screen: Option<ClaudeScreen>,
+    /// Files Claude edited in this session (10e attribution); drives the `?` glyph and the
+    /// changes view.
+    pub touched: BTreeSet<PathBuf>,
+    /// Last path Claude asked to reveal; the navigation phase moves the cursor to it.
+    pub reveal: Option<PathBuf>,
+}
+
+impl ClaudeState {
+    pub fn next_generation(&mut self) -> u64 {
+        self.generation += 1;
+        self.generation
+    }
+
+    pub fn is_running(&self) -> bool {
+        self.phase == ClaudePhase::Running
+    }
+}
