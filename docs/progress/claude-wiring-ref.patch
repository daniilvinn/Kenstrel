+                path: PathBuf::from("/work/proj/b.rs"),
+            },
+        );
+        assert!(s.claude.touched.contains(&PathBuf::from("/work/proj/a.rs")));
+        assert_eq!(s.claude.reveal, Some(PathBuf::from("/work/proj/b.rs")));
+    }
+
+    #[test]
+    fn focus_toggle_without_a_pane_explains() {
+        let mut s = state();
+        key(&mut s, "ctrl-\\");
+        assert!(s.status.as_ref().unwrap().text.contains("not running"));
+        assert!(s.overlays.is_empty());
+    }
+
+    #[test]
+    fn send_paths_requires_a_running_pane() {
+        let mut s = state();
+        let paths = vec![PathBuf::from("/work/proj/a.rs")];
+        assert!(update(&mut s, Msg::ClaudeSendPaths(paths.clone())).is_empty());
+        running(&mut s);
+        let effects = update(&mut s, Msg::ClaudeSendPaths(paths.clone()));
+        assert_eq!(effects, vec![Effect::ClaudeSendPaths { paths }]);
+    }
+}
diff --git a/crates/ks-ui/src/claude.rs b/crates/ks-ui/src/claude.rs
new file mode 100644
index 0000000..8e76443
--- /dev/null
+++ b/crates/ks-ui/src/claude.rs
@@ -0,0 +1,260 @@
+//! The embedded Claude Code pane and the Claude dialogs (PLAN section 10).
+
+use ratatui::layout::{Alignment, Position, Rect};
+use ratatui::style::{Color, Modifier, Style};
+use ratatui::text::{Line, Span};
+use ratatui::widgets::{Block, Borders, Clear, Paragraph, Wrap};
+use ratatui::Frame;
+
+use ks_core::claude::{pane_area, ClaudeColor, ClaudeScreen};
+use ks_core::{AppState, ClaudeDialog, Overlay};
+
+use crate::theme::Theme;
+
+fn color(c: ClaudeColor) -> Color {
+    match c {
+        ClaudeColor::Default => Color::Reset,
+        ClaudeColor::Indexed(i) => Color::Indexed(i),
+        ClaudeColor::Rgb(r, g, b) => Color::Rgb(r, g, b),
+    }
+}
+
+/// Draws the pane when Claude is running and has produced a screen.
+pub fn render_pane(frame: &mut Frame, state: &AppState, theme: &Theme) {
+    let Some(screen) = state
+        .claude
+        .screen
+        .as_ref()
+        .filter(|_| state.claude.is_running())
+    else {
+        return;
+    };
+    let Some(area) = pane_area(state.size) else {
+        return;
+    };
+    let outer = Rect::new(area.x, area.y, area.width, area.height).intersection(frame.area());
+    if outer.width < 2 || outer.height == 0 {
+        return;
+    }
+    let focused = state.overlays.last() == Some(&Overlay::Claude);
+    let border = if focused { theme.accent } else { theme.border };
+    let block = Block::new()
+        .borders(Borders::LEFT)
+        .border_style(Style::new().fg(border))
+        .style(Style::new().bg(theme.bg));
+    let inner = block.inner(outer);
+    frame.render_widget(block, outer);
+    draw_screen(frame, inner, screen);
+
+    if focused {
+        if let Some((row, col)) = screen.cursor {
+            if row < inner.height && col < inner.width {
+                frame.set_cursor_position(Position::new(inner.x + col, inner.y + row));
+            }
+        }
+    }
+}
+
+fn draw_screen(frame: &mut Frame, inner: Rect, screen: &ClaudeScreen) {
+    let buf = frame.buffer_mut();
+    for row in 0..inner.height.min(screen.rows) {
+        for col in 0..inner.width.min(screen.cols) {
+            let Some(cell) = screen.cell(row, col) else {
+                continue;
+            };
+            let (mut fg, mut bg) = (color(cell.fg), color(cell.bg));
+            if cell.inverse {
+                std::mem::swap(&mut fg, &mut bg);
+                // A reversed default colour must still be visible on the real background.
+                if fg == Color::Reset {
+                    fg = Color::Black;
+                }
+                if bg == Color::Reset {
+                    bg = Color::White;
+                }
+            }
+            let mut style = Style::new().fg(fg).bg(bg);
+            for (on, modifier) in [
+                (cell.bold, Modifier::BOLD),
+                (cell.dim, Modifier::DIM),
+                (cell.italic, Modifier::ITALIC),
+                (cell.underline, Modifier::UNDERLINED),
+            ] {
+                if on {
+                    style = style.add_modifier(modifier);
+                }
+            }
+            if let Some(target) = buf.cell_mut(Position::new(inner.x + col, inner.y + row)) {
+                target.reset();
+                target.set_style(style);
+                // Blank and wide-continuation cells keep a space so stale glyphs are overwritten.
+                target.set_symbol(if cell.text.is_empty() {
+                    " "
+                } else {
+                    &cell.text
+                });
+            }
+        }
+    }
+}
+
+/// Draws the install / billing / login dialog when one is pending.
+pub fn render_dialog(frame: &mut Frame, state: &AppState, theme: &Theme) {
+    if state.overlays.last() != Some(&Overlay::Confirm) {
+        return;
+    }
+    let Some(dialog) = &state.claude.dialog else {
+        return;
+    };
+    let (title, body, footer, accent) = match dialog {
+        ClaudeDialog::Billing(text) => (
+            "Claude would bill your API key",
+            text.as_str(),
+            "enter: launch anyway    esc: cancel",
+            theme.warning,
+        ),
+        ClaudeDialog::Info { title, body } => (
+            title.as_str(),
+            body.as_str(),
+            "enter / esc: close",
+            theme.accent,
+        ),
+    };
+    let area = frame.area();
+    let width = area.width.saturating_sub(4).clamp(1, 72);
+    let text_lines = u16::try_from(body.lines().count()).unwrap_or(u16::MAX);
+    let height = text_lines
+        .saturating_add(5)
+        .min(area.height.saturating_sub(2))
+        .max(3.min(area.height));
+    let rect = Rect::new(
+        area.x + area.width.saturating_sub(width) / 2,
+        area.y + area.height.saturating_sub(height) / 2,
+        width.min(area.width),
+        height,
+    );
+    frame.render_widget(Clear, rect);
+    let block = Block::bordered()
+        .border_style(Style::new().fg(accent))
+        .title(Span::styled(
+            format!(" {title} "),
+            Style::new().fg(accent).add_modifier(Modifier::BOLD),
+        ))
+        .style(theme.base_style());
+    let inner = block.inner(rect);
+    frame.render_widget(block, rect);
+    let mut lines: Vec<Line> = body.lines().map(Line::from).collect();
+    lines.push(Line::default());
+    lines.push(Line::styled(footer, theme.muted()).alignment(Alignment::Left));
+    frame.render_widget(Paragraph::new(lines).wrap(Wrap { trim: false }), inner);
+}
+
+#[cfg(test)]
+mod tests {
+    use std::path::PathBuf;
+
+    use ks_core::claude::{ClaudeCell, ClaudePhase};
+    use ks_core::{Config, Keymap, Size, StartParams};
+    use ratatui::backend::TestBackend;
+    use ratatui::Terminal;
+
+    use super::*;
+    use crate::theme::ColorDepth;
+
+    fn state() -> AppState {
+        AppState::new(StartParams {
+            cwd: PathBuf::from("/work"),
+            home: None,
+            config: Config::default(),
+            keymap: Keymap::defaults(),
+            size: Size::new(100, 30),
+        })
+    }
+
+    fn screen(rows: u16, cols: u16, text: &str) -> ClaudeScreen {
+        let mut cells = vec![ClaudeCell::default(); usize::from(rows) * usize::from(cols)];
+        for (i, ch) in text.chars().enumerate() {
+            cells[i].text = ch.to_string();
+        }
+        cells[0].inverse = true;
+        cells[1].fg = ClaudeColor::Rgb(1, 2, 3);
+        ClaudeScreen {
+            cols,
+            rows,
+            cells,
+            cursor: Some((0, 3)),
+        }
+    }
+
+    fn draw(state: &AppState) -> Terminal<TestBackend> {
+        let theme = Theme::builtin("ember", ColorDepth::TrueColor).unwrap();
+        let mut terminal =
+            Terminal::new(TestBackend::new(state.size.width, state.size.height)).unwrap();
+        terminal.draw(|f| crate::render(f, state, &theme)).unwrap();
+        terminal
+    }
+
+    fn row(terminal: &Terminal<TestBackend>, y: u16) -> String {
+        let buf = terminal.backend().buffer();
+        (0..buf.area.width).map(|x| buf[(x, y)].symbol()).collect()
+    }
+
+    #[test]
+    fn running_pane_is_drawn_with_colours_and_cursor() {
+        let mut s = state();
+        let area = pane_area(s.size).unwrap();
+        let inner = area.inner_size();
+        s.claude.phase = ClaudePhase::Running;
+        s.claude.screen = Some(screen(inner.height, inner.width, "Hello Claude"));
+        s.overlays.push(Overlay::Claude);
+        let terminal = draw(&s);
+        let line = row(&terminal, area.y);
+        assert!(line.contains("Hello Claude"), "{line}");
+        let buf = terminal.backend().buffer();
+        // x + 1 skips the border; cell 1 has the rgb foreground, cell 0 is inverse.
+        assert_eq!(buf[(area.x + 2, area.y)].fg, Color::Rgb(1, 2, 3));
+        assert_eq!(buf[(area.x + 1, area.y)].bg, Color::White);
+        assert_eq!(buf[(area.x, area.y)].symbol(), "?");
+    }
+
+    #[test]
+    fn nothing_is_drawn_without_a_running_pane() {
+        let mut s = state();
+        s.claude.screen = Some(screen(5, 5, "ghost"));
+        let terminal = draw(&s);
+        assert!(!row(&terminal, 2).contains("ghost"));
+    }
+
+    #[test]
+    fn dialogs_show_text_and_footer() {
+        let mut s = state();
+        s.claude.dialog = Some(ClaudeDialog::Billing("Claude would bill your key".into()));
+        s.overlays.push(Overlay::Confirm);
+        let terminal = draw(&s);
+        let all: String = (0..s.size.height).map(|y| row(&terminal, y)).collect();
+        assert!(all.contains("Claude would bill your key"));
+        assert!(all.contains("launch anyway"));
+
+        s.claude.dialog = Some(ClaudeDialog::Info {
+            title: "Claude Code is not installed".into(),
+            body: "Install it with:\n  irm https://claude.ai/install.ps1 | iex".into(),
+        });
+        let terminal = draw(&s);
+        let all: String = (0..s.size.height).map(|y| row(&terminal, y)).collect();
+        assert!(all.contains("not installed"));
+        assert!(all.contains("install.ps1"));
+    }
+
+    #[test]
+    fn tiny_terminals_do_not_panic() {
+        for (w, h) in [(0, 0), (3, 3), (30, 8), (200, 5)] {
+            let mut s = state();
+            s.size = Size::new(w, h);
+            s.claude.phase = ClaudePhase::Running;
+            s.claude.screen = Some(screen(10, 10, "x"));
+            s.claude.dialog = Some(ClaudeDialog::Billing("x".repeat(500)));
+            s.overlays.push(Overlay::Confirm);
+            draw(&s);
+        }
+    }
+}
