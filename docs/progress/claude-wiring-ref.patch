+            Request::ListDir { path: ".".into() },
+            &state(dir.path()),
+        ));
+        let Response::Dir { entries } = resp else {
+            panic!("{resp:?}")
+        };
+        let names: Vec<_> = entries.iter().map(|e| e.name.as_str()).collect();
+        assert_eq!(
+            names,
+            [".git", "node_modules", "src", "blob.bin", "README.md"]
+        );
+        assert!(matches!(
+            list_dir(&dir.path().join("missing")),
+            Response::Error { .. }
+        ));
+    }
+
+    #[test]
+    fn search_files_ranks_and_skips_vendor_dirs() {
+        let dir = tree();
+        let s = state(dir.path());
+        let (resp, _) = run(answer(
+            Request::SearchFiles {
+                query: "main".into(),
+                root: None,
+                limit: 10,
+            },
+            &s,
+        ));
+        let Response::Files { paths, truncated } = resp else {
+            panic!("{resp:?}")
+        };
+        assert!(!truncated);
+        assert_eq!(paths.len(), 1);
+        assert!(paths[0].ends_with("main.rs"));
+
+        // Subsequence match, and nothing from .git / node_modules.
+        let Response::Files { paths, .. } = search_files(dir.path(), "i", 50) else {
+            panic!()
+        };
+        assert!(paths
+            .iter()
+            .all(|p| !p.contains(".git") && !p.contains("node_modules")));
+
+        let Response::Files { paths, truncated } = search_files(dir.path(), "r", 2) else {
+            panic!()
+        };
+        assert_eq!(paths.len(), 2);
+        assert!(truncated);
+    }
+
+    #[test]
+    fn search_contents_literal_regex_glob_and_limit() {
+        let dir = tree();
+        let root = dir.path();
+        // Lower-case pattern is case-insensitive, so README's "hello World" matches too.
+        let Response::Matches { hits, .. } = search_contents(root, "hello", None, false, 50) else {
+            panic!()
+        };
+        let files: Vec<_> = hits
+            .iter()
+            .map(|h| relative_slashes(Path::new(&h.path), root))
+            .collect();
+        assert!(files.contains(&"README.md".to_owned()));
+        assert!(files.contains(&"src/main.rs".to_owned()));
+        assert!(files.contains(&"src/deep/mod.rs".to_owned()));
+        assert_eq!(
+            files.len(),
+            3,
+            "binary, .git and node_modules are skipped: {files:?}"
+        );
+
+        let Response::Matches { hits, .. } =
+            search_contents(root, r"fn \w+\(", Some("*.rs"), true, 50)
+        else {
+            panic!()
+        };
+        assert_eq!(hits.len(), 2);
+        assert!(hits
+            .iter()
+            .any(|h| h.line == 1 && h.text.starts_with("fn main")));
+
+        let Response::Matches { hits, truncated } =
+            search_contents(root, "hello", Some("src/**/*.rs"), false, 50)
+        else {
+            panic!()
+        };
+        assert_eq!(hits.len(), 1);
+        assert!(!truncated);
+
+        let Response::Matches { hits, truncated } = search_contents(root, "hello", None, false, 1)
+        else {
+            panic!()
+        };
+        assert_eq!((hits.len(), truncated), (1, true));
+
+        assert!(matches!(
+            search_contents(root, "(", None, true, 5),
+            Response::Error { .. }
+        ));
+        assert!(matches!(
+            search_contents(root, "", None, false, 5),
+            Response::Error { .. }
+        ));
+    }
+
+    #[test]
+    fn glob_matching() {
+        assert!(glob_match("*.rs", "main.rs"));
+        assert!(glob_match("*.RS", "main.rs"));
+        assert!(!glob_match("*.rs", "main.rsx"));
+        assert!(glob_match("src/**/*.rs", "src/deep/mod.rs"));
+        assert!(glob_match("a?c", "abc"));
+        assert!(!glob_match("a?c", "ac"));
+        assert!(glob_match("*", ""));
+    }
+}
