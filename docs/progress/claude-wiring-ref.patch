+fn is_current_claude(state: &AppState, generation: u64) -> bool {
+    state.claude.generation == generation
+}
+
+/// Gives the Claude pane keyboard focus (idempotent).
+fn focus_claude(state: &mut AppState) {
+    if !state.overlays.contains(&Overlay::Claude) {
+        state.overlays.push(Overlay::Claude);
+    }
+}
+
+/// Back to "no Claude": drops focus, screen and any pending dialog.
+fn reset_claude(state: &mut AppState) {
+    state.overlays.retain(|o| *o != Overlay::Claude);
+    state.claude.phase = ClaudePhase::Idle;
+    state.claude.screen = None;
+    state.dirty = true;
+}
+
+fn start_claude(state: &mut AppState, resume: bool, effects: &mut Vec<Effect>) {
+    match state.claude.phase {
+        ClaudePhase::Running => {
+            focus_claude(state);
+        }
+        ClaudePhase::Checking | ClaudePhase::Starting => set_status(
+            state,
+            Level::Info,
+            "Claude is already starting".to_owned(),
+            effects,
+        ),
+        ClaudePhase::Idle => {
+            state.claude.resume = resume;
+            state.claude.phase = ClaudePhase::Checking;
+            let generation = state.claude.next_generation();
+            effects.push(Effect::ClaudePreflight { generation });
+            set_status(
+                state,
+                Level::Info,
+                "Checking Claude login...".to_owned(),
+                effects,
+            );
+        }
+    }
+}
+
+fn toggle_claude_focus(state: &mut AppState, effects: &mut Vec<Effect>) {
+    if state.overlays.last() == Some(&Overlay::Claude) {
+        state.overlays.pop();
+    } else if state.claude.is_running() && state.overlays.is_empty() {
+        focus_claude(state);
+    } else {
+        set_status(
+            state,
+            Level::Info,
+            "Claude is not running (press c to open it)".to_owned(),
+            effects,
+        );
+    }
+}
+
+fn launch_claude(state: &mut AppState, effects: &mut Vec<Effect>) {
+    let Some(area) = claude::pane_area(state.size) else {
+        reset_claude(state);
+        set_status(
+            state,
+            Level::Warning,
+            "The terminal is too small for the Claude pane".to_owned(),
+            effects,
+        );
+        return;
+    };
+    state.claude.phase = ClaudePhase::Starting;
+    effects.push(Effect::ClaudeLaunch {
+        generation: state.claude.generation,
+        cwd: state.cwd.clone(),
+        resume: state.claude.resume,
+        size: area.inner_size(),
+    });
+}
+
+fn on_claude_preflight(
+    state: &mut AppState,
+    generation: u64,
+    result: ClaudePreflight,
+    effects: &mut Vec<Effect>,
+) {
+    if !is_current_claude(state, generation) || state.claude.phase != ClaudePhase::Checking {
+        return;
+    }
+    state.dirty = true;
+    let info = |title: &str, body: String| ClaudeDialog::Info {
+        title: title.to_owned(),
+        body,
+    };
+    let dialog = match result {
+        ClaudePreflight::Ok => {
+            launch_claude(state, effects);
+            return;
+        }
+        ClaudePreflight::BillingWarning(text) => ClaudeDialog::Billing(text),
+        ClaudePreflight::NotLoggedIn(text) => info("Claude is not logged in", text),
+        ClaudePreflight::NotInstalled(text) => info("Claude Code is not installed", text),
+        ClaudePreflight::Failed(text) => info("Could not check Claude", text),
+    };
+    state.claude.phase = ClaudePhase::Idle;
+    state.claude.dialog = Some(dialog);
+    state.status = None;
+    state.status_gen.bump();
+    effects.push(Effect::CancelTimer(TimerKind::StatusExpiry));
+    state.overlays.push(Overlay::Confirm);
+}
