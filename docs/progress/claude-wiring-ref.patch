+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn wide_terminals_get_a_side_pane() {
+        let area = pane_area(Size::new(120, 32)).unwrap();
+        assert_eq!(area.width, 54);
+        assert_eq!(area.x, 66);
+        assert_eq!(area.y, 2);
+        assert_eq!(area.height, 32 - 4 - 1);
+        assert_eq!(area.inner_size(), Size::new(53, 27));
+    }
+
+    #[test]
+    fn narrow_terminals_get_a_full_width_pane() {
+        let area = pane_area(Size::new(70, 24)).unwrap();
+        assert_eq!((area.x, area.width), (0, 70));
+    }
+
+    #[test]
+    fn tiny_terminals_have_no_pane() {
+        assert!(pane_area(Size::new(80, 4)).is_none());
+        assert!(pane_area(Size::new(2, 30)).is_none());
+        assert!(pane_area(Size::new(0, 0)).is_none());
+    }
+
+    #[test]
+    fn hint_line_is_not_part_of_the_pane() {
+        assert_eq!(pane_area(Size::new(100, 19)).unwrap().height, 15);
+        assert_eq!(pane_area(Size::new(100, 20)).unwrap().height, 15);
+    }
+
+    #[test]
+    fn screen_cell_lookup_is_bounds_checked() {
+        let screen = ClaudeScreen {
+            cols: 2,
+            rows: 1,
+            cells: vec![ClaudeCell::default(); 2],
+            cursor: None,
+        };
+        assert!(screen.cell(0, 1).is_some());
+        assert!(screen.cell(1, 0).is_none());
+        assert!(screen.cell(0, 2).is_none());
+    }
+}
