+    let mut line = String::new();
+    stdout.read_line(&mut line).unwrap();
+    let reply: serde_json::Value = serde_json::from_str(&line).expect(&line);
+    assert_eq!(reply["id"], 1, "{line}");
+    assert!(reply["result"]["serverInfo"].is_object(), "{line}");
+    drop(stdin); // EOF ends the server
+    let status = child.wait().unwrap();
+    assert!(status.success() || status.code().is_some());
