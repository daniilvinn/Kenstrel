diff --git a/crates/ks-app/src/ipc_handler.rs b/crates/ks-app/src/ipc_handler.rs
new file mode 100644
index 0000000..306f7c8
--- /dev/null
+++ b/crates/ks-app/src/ipc_handler.rs
@@ -0,0 +1,576 @@
+//! Answers the requests that Claude's MCP / hook processes send over IPC (PLAN 10d, 10e).
+//!
+//! Requests that only need app state (`GetSelection`, `Reveal`, `HookEvent`) are answered
+//! inline. Requests that touch the file system (`SearchFiles`, `SearchContents`, `ListDir`)
+//! become a closure the caller runs on a blocking thread, so the UI loop never waits on disk.
+//!
+//! The walker here is a self-contained stand-in until `ks-search`'s index is wired in; it skips
+//! `.git`, `node_modules`, `target` and similar, never follows symlinks, and is bounded in
+//! files visited, bytes read and wall-clock time.
+
+use std::fs;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use ks_claude::ipc::{ContentHit, DirEntry, Request, Response};
+use ks_core::{AppState, Msg};
+use regex::RegexBuilder;
+
+const MAX_LIST_ENTRIES: usize = 2000;
+const MAX_WALK_FILES: usize = 200_000;
+const MAX_FILE_BYTES: u64 = 2 * 1024 * 1024;
+const MAX_LINE_CHARS: usize = 300;
+const SEARCH_BUDGET: Duration = Duration::from_secs(8);
+const SKIPPED_DIRS: &[&str] = &[
+    ".git",
+    "node_modules",
+    "target",
+    "$RECYCLE.BIN",
+    "System Volume Information",
+];
+
+/// How a request is answered.
+pub enum Outcome {
+    /// Answer now; also apply these messages to the state.
+    Now(Response, Vec<Msg>),
+    /// Run this on a blocking thread and send its result as the answer.
+    Blocking(Box<dyn FnOnce() -> Response + Send>),
+}
+
+/// Decides how to answer `request` given the current state.
+pub fn answer(request: Request, state: &AppState) -> Outcome {
+    let cwd = state.cwd.clone();
+    match request {
+        Request::GetSelection => Outcome::Now(
+            Response::Selection {
+                // Marks and the cursor entry arrive with the navigation phase.
+                marked: Vec::new(),
+                cursor: None,
+                cwd: path_string(&cwd),
+            },
+            Vec::new(),
+        ),
+        Request::Reveal { path } => {
+            let target = resolve(&cwd, &path);
+            if target.exists() {
+                Outcome::Now(Response::Ok, vec![Msg::ClaudeReveal { path: target }])
+            } else {
+                Outcome::Now(
+                    error(format!("{} does not exist", target.display())),
+                    vec![],
+                )
+            }
+        }
+        Request::HookEvent {
+            session_id,
+            tool_name,
+            file_path,
+        } => {
+            let msgs = file_path
+                .map(|p| Msg::ClaudeEdited {
+                    session_id,
+                    tool_name,
+                    path: resolve(&cwd, &p),
+                })
+                .into_iter()
+                .collect();
+            Outcome::Now(Response::Ok, msgs)
+        }
+        Request::ListDir { path } => {
+            Outcome::Blocking(Box::new(move || list_dir(&resolve(&cwd, &path))))
+        }
+        Request::SearchFiles { query, root, limit } => {
+            let root = root.map_or(cwd.clone(), |r| resolve(&cwd, &r));
+            Outcome::Blocking(Box::new(move || search_files(&root, &query, limit)))
+        }
+        Request::SearchContents {
+            pattern,
+            glob,
+            regex,
+            limit,
+        } => Outcome::Blocking(Box::new(move || {
+            search_contents(&cwd, &pattern, glob.as_deref(), regex, limit)
+        })),
+    }
+}
+
+fn error(message: String) -> Response {
+    Response::Error { message }
+}
+
+fn path_string(path: &Path) -> String {
+    dunce::simplified(path).to_string_lossy().into_owned()
+}
+
+fn resolve(base: &Path, path: &str) -> PathBuf {
+    let p = Path::new(path);
+    if p.is_absolute() {
+        p.to_path_buf()
+    } else {
+        base.join(p)
+    }
+}
+
+/// `ListDir`: directories first, then files, each sorted case-insensitively.
+pub fn list_dir(path: &Path) -> Response {
+    let read = match fs::read_dir(path) {
+        Ok(read) => read,
+        Err(e) => return error(format!("cannot list {}: {e}", path.display())),
+    };
+    let mut entries: Vec<DirEntry> = read
+        .filter_map(Result::ok)
+        .take(MAX_LIST_ENTRIES)
+        .map(|entry| {
+            let meta = entry.metadata().ok();
+            let is_dir = meta.as_ref().is_some_and(fs::Metadata::is_dir);
+            DirEntry {
+                name: entry.file_name().to_string_lossy().into_owned(),
+                is_dir,
+                size: meta.filter(|m| m.is_file()).map(|m| m.len()),
+            }
+        })
+        .collect();
+    entries.sort_by_cached_key(|e| (!e.is_dir, e.name.to_lowercase()));
+    Response::Dir { entries }
+}
+
+/// Visits files below `root` (never following symlinks) until `visit` returns false or a
+/// budget is exhausted.
+fn walk(root: &Path, mut visit: impl FnMut(&Path) -> bool) {
+    let deadline = Instant::now() + SEARCH_BUDGET;
+    let mut stack = vec![root.to_path_buf()];
+    let mut visited = 0usize;
+    while let Some(dir) = stack.pop() {
+        let Ok(read) = fs::read_dir(&dir) else {
+            continue;
+        };
+        let mut children: Vec<_> = read.filter_map(Result::ok).collect();
+        children.sort_by_key(fs::DirEntry::file_name);
+        // Reverse so the stack pops in alphabetical order.
+        for entry in children.into_iter().rev() {
+            let Ok(kind) = entry.file_type() else {
+                continue;
+            };
+            let name = entry.file_name();
+            if kind.is_dir() {
+                if !SKIPPED_DIRS.iter().any(|s| name.to_string_lossy() == *s) {
+                    stack.push(entry.path());
+                }
+            } else if kind.is_file() {
+                visited += 1;
+                if visited > MAX_WALK_FILES
+                    || (visited.is_multiple_of(256) && Instant::now() >= deadline)
+                    || !visit(&entry.path())
+                {
+                    return;
+                }
+            }
+        }
+    }
+}
+
+/// Lower is better; `None` when `query` does not match.
+fn fuzzy_score(relative: &str, query: &str) -> Option<usize> {
+    let hay = relative.to_lowercase();
+    let needle = query.to_lowercase();
+    if needle.is_empty() {
+        return Some(0);
+    }
+    let base_start = hay.rfind('/').map_or(0, |i| i + 1);
+    if let Some(pos) = hay[base_start..].find(&needle) {
+        // Substring of the file name: best, earlier is better.
+        return Some(pos);
+    }
+    if let Some(pos) = hay.find(&needle) {
+        return Some(1000 + pos);
+    }
+    // Subsequence anywhere in the path; tighter spans score better.
+    let mut chars = needle.chars();
+    let mut want = chars.next()?;
+    let mut first: Option<usize> = None;
+    for (i, c) in hay.char_indices() {
+        if c == want {
+            let start = *first.get_or_insert(i);
+            match chars.next() {
+                Some(next) => want = next,
+                None => return Some(2000 + i - start),
+            }
+        }
+    }
+    None
+}
+
+fn relative_slashes(path: &Path, root: &Path) -> String {
+    path.strip_prefix(root)
+        .unwrap_or(path)
+        .to_string_lossy()
+        .replace('\\', "/")
+}
+
+/// `SearchFiles`: fuzzy match of `query` against paths relative to `root`.
+pub fn search_files(root: &Path, query: &str, limit: usize) -> Response {
+    if !root.is_dir() {
+        return error(format!("{} is not a directory", root.display()));
+    }
+    let limit = limit.clamp(1, 1000);
+    let mut scored: Vec<(usize, usize, PathBuf)> = Vec::new();
+    walk(root, |path| {
+        let relative = relative_slashes(path, root);
+        if let Some(score) = fuzzy_score(&relative, query) {
+            scored.push((score, relative.len(), path.to_path_buf()));
+        }
+        true
+    });
+    scored.sort();
+    let truncated = scored.len() > limit;
+    scored.truncate(limit);
+    Response::Files {
+        paths: scored.iter().map(|(_, _, p)| path_string(p)).collect(),
+        truncated,
+    }
+}
+
+/// Minimal glob: `*` and `**` match any run of characters, `?` one character.
+pub fn glob_match(pattern: &str, text: &str) -> bool {
+    let p: Vec<char> = pattern.to_lowercase().chars().collect();
+    let t: Vec<char> = text.to_lowercase().chars().collect();
+    let (mut pi, mut ti) = (0, 0);
+    let mut star: Option<(usize, usize)> = None;
+    while ti < t.len() {
+        if pi < p.len() && (p[pi] == '?' || p[pi] == t[ti]) && p[pi] != '*' {
+            pi += 1;
+            ti += 1;
+        } else if pi < p.len() && p[pi] == '*' {
+            star = Some((pi, ti));
+            pi += 1;
+        } else if let Some((sp, st)) = star {
+            pi = sp + 1;
+            ti = st + 1;
+            star = Some((sp, st + 1));
+        } else {
+            return false;
+        }
+    }
+    p[pi..].iter().all(|c| *c == '*')
+}
+
+fn glob_selects(glob: &str, relative: &str) -> bool {
+    if glob.contains('/') {
+        glob_match(glob, relative)
+    } else {
+        let name = relative.rsplit('/').next().unwrap_or(relative);
+        glob_match(glob, name)
+    }
+}
+
+fn read_text(path: &Path) -> Option<String> {
+    let meta = fs::metadata(path).ok()?;
+    if meta.len() > MAX_FILE_BYTES {
+        return None;
+    }
+    let mut bytes = Vec::new();
+    fs::File::open(path)
+        .ok()?
+        .take(MAX_FILE_BYTES)
+        .read_to_end(&mut bytes)
+        .ok()?;
+    if bytes.iter().take(8192).any(|b| *b == 0) {
+        return None;
+    }
+    Some(String::from_utf8_lossy(&bytes).into_owned())
+}
+
+/// `SearchContents`: literal (case-insensitive when the pattern is all lower case) or regex.
+pub fn search_contents(
+    root: &Path,
+    pattern: &str,
+    glob: Option<&str>,
+    regex: bool,
+    limit: usize,
+) -> Response {
+    if pattern.is_empty() {
+        return error("empty pattern".to_owned());
+    }
+    let limit = limit.clamp(1, 2000);
+    let source = if regex {
+        pattern.to_owned()
+    } else {
+        regex::escape(pattern)
+    };
+    let smart_case = pattern.chars().all(|c| !c.is_uppercase());
+    let matcher = match RegexBuilder::new(&source)
+        .case_insensitive(smart_case)
+        .size_limit(1 << 20)
+        .build()
+    {
+        Ok(m) => m,
+        Err(e) => return error(format!("invalid pattern: {e}")),
+    };
+    let mut hits = Vec::new();
+    let mut truncated = false;
+    walk(root, |path| {
+        let relative = relative_slashes(path, root);
+        if glob.is_some_and(|g| !glob_selects(g, &relative)) {
+            return true;
+        }
+        let Some(text) = read_text(path) else {
+            return true;
+        };
+        for (index, line) in text.lines().enumerate() {
+            if matcher.is_match(line) {
+                if hits.len() == limit {
+                    truncated = true;
+                    return false;
+                }
+                hits.push(ContentHit {
+                    path: path_string(path),
+                    line: index + 1,
+                    text: line.chars().take(MAX_LINE_CHARS).collect(),
+                });
+            }
+        }
+        true
+    });
+    Response::Matches { hits, truncated }
+}
+
